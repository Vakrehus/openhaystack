# Base64 advertisement key of your accessory.
# In the OpenHaystack app: right-click an accessory -> "Copy advertisement key (Base64)".
# Install this file as /etc/openhaystack/advertisement-key.env and restrict it:
#   install -m 600 advertisement-key.env /etc/openhaystack/advertisement-key.env
ADVERTISEMENT_KEY=PASTE_BASE64_KEY_HERE
